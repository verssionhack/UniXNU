+def relocate_absolute_branches(data, layout):
+    """Retarget direct branches from native text to retained N_ABS functions.
+
+    A branch to an absolute linker symbol has no split-segment relocation. Its
+    immediate is correct in the standalone executable but becomes wrong when
+    the native text moves within the fileset. Decode the standalone instruction
+    and recompute its immediate from the placed site; never reuse a slide from
+    another build.
+    """
+    from kc_image import signed
+    native = layout.native
+    targets = {}
+    for name, address in native.absolute_symbols().items():
+        if name.endswith('.original'):
+            continue  # The BTI/B adapter has its own stricter check above.
+        targets.setdefault(address, []).append(name)
+    text_sections = [s for s in native.sections
+                     if s['segment'] == '__TEXT_EXEC' and s['name'] == '__text']
+    if len(text_sections) != 1:
+        raise ValueError('Expected one native executable text section')
+    section = text_sections[0]
+    code = native.read(section['va'], section['size'])
+    result = []
+    for offset in range(0, len(code) - 3, 4):
+        old_site = section['va'] + offset
+        word, = struct.unpack_from('<I', code, offset)
+        opcode = word & 0xfc000000
+        if opcode not in (0x14000000, 0x94000000):
+            continue
+        old_target = old_site + signed(word & 0x3ffffff, 26) * 4
+        names = targets.get(old_target)
+        if not names:
+            continue
+        owners = [owner for begin, end, owner in layout.retained_code
+                  if begin <= old_target < end]
+        if len(owners) != 1:
+            raise ValueError(f'Absolute branch target is not retained executable code: '
+                             f'{old_site:#x} -> {old_target:#x} ({names})')
+        new_site = layout.translate(old_site)
+        displacement = old_target - new_site
+        if displacement % 4 or not -(1 << 27) <= displacement < 1 << 27:
+            raise ValueError(f'Absolute branch out of range: {old_site:#x} -> {old_target:#x}')
+        rewritten = opcode | ((displacement >> 2) & 0x3ffffff)
+        struct.pack_into('<I', data, new_site - layout.cache.base, rewritten)
+        decoded = new_site + signed(rewritten & 0x3ffffff, 26) * 4
+        if decoded != old_target:
+            raise ValueError(f'Absolute branch verification failed at {new_site:#x}')
+        result.append(dict(source=hex(new_site), target=hex(old_target),
+                           symbols=sorted(names), owner=owners[0],
+                           operation='BL' if opcode == 0x94000000 else 'B'))
+    return result
+
+
