+    # ld64 can encode authenticated pointers to N_ABS symbols in a native
+    # vtable without adding those sites to the standalone chain starts. The
+    # copied word is an encoded pointer, not a usable runtime VA; include it
+    # in the rebuilt root chain so dyld rebases/authenticates it.
+    absolute = set(native.absolute_symbols().values())
+    for section in native.sections:
+        if section['segment'] != '__DATA_CONST' or section['va'] % 8:
+            continue
